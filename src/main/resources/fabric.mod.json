{
	"schemaVersion": 1,
	"id": "enhancem",
	"version": "${version}",
	"name": "EnhanceM",
	"description": "A mob behavior enhancement mod.",
	"authors": [
		"jed"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/enhancem/icon.png",
